{
  "name": "histae-api",
  "version": "3.0.0",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "description": "Histae API — NestJS and Fastify backend for the Histae mobile application.",
  "scripts": {
    "build": "nest build",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "db:migrate": "ts-node scripts/migrate.ts",
    "db:reset": "ts-node scripts/reset.ts",
    "db:reset-scylla": "ts-node scripts/reset-scylla.ts",
    "scylla:migrate": "ts-node scripts/scylla-migrate.ts",
    "seed:swipes": "ts-node scripts/seed-fake-swipe.ts",
    "fixtures:photos": "ts-node scripts/generate-photo-fixtures.ts",
    "maintenance:run": "ts-node scripts/maintenance.ts",
    "outbox:work": "ts-node scripts/outbox-worker.ts",
    "test": "jest --runInBand --testPathIgnorePatterns=test/integration",
    "test:unit": "jest --runInBand --testPathPatterns=test/unit",
    "test:e2e": "jest --runInBand --testPathPatterns=test/e2e",
    "test:integration": "jest --runInBand --testPathPatterns=test/integration",
    "test:integration:postgres": "jest --runInBand --testPathPatterns=test/integration/postgres.schema.integration.spec.ts",
    "test:integration:scylla": "jest --runInBand --testPathPatterns=test/integration/scylla.discovery.integration.spec.ts",
    "test:integration:redis": "jest --runInBand --testPathPatterns=test/integration/redis.integration.spec.ts",
    "test:watch": "jest --watch --testPathIgnorePatterns=test/integration",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts test --max-warnings=0",
    "lint:fix": "eslint src scripts test --fix"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1121.0",
    "@aws-sdk/s3-request-presigner": "^3.1121.0",
    "@fastify/multipart": "^10.1.1",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-fastify": "^11.1.12",
    "cassandra-driver": "4.9.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^17.2.3",
    "fastify": "^5.0.0",
    "heic-decode": "2.1.0",
    "pg": "^8.17.1",
    "redis": "^4.7.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.4",
    "stripe": "22.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.16.0",
    "eslint": "^10.8.1",
    "jest": "^30.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.67.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": "test/.*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testEnvironment": "node"
  }
}
